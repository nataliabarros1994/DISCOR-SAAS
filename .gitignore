RESEND_*.md
IMPLEMENTATION_*.md
PRODUCTION_*.md
FEATURES_*.md
CHECKLIST_*.md
GUIA_*.md
PASSO_*.md
QUICK_*.md
SETUP_*.md
TEST_*.md
VALIDATION_*.md
STATUS.md
NEXT_STEP.md

# Keep important documentation
!README.md
!CONTRIBUTING.md
!LICENSE.md
!CHANGELOG.md

# Scripts that may contain secrets
*.sh.backup
check-env.js
clear-*.js
reset-*.js
test-*.sh
setup-*.sh
wake-*.sh
restart-*.sh
start-*.sh

# Keep safe scripts
!quick-start.sh
!wake-database.sh

